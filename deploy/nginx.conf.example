# StayDesk · nginx. Copie nginx-headers.conf a /etc/nginx/snippets/staydesk-headers.conf y use este bloque dentro de su server { ... } con HTTPS:
#
#   root /var/www/staydesk;
#   index index.html;
#   include snippets/staydesk-headers.conf;
#   gzip on;
#   gzip_types text/html text/css application/javascript application/json;
#   # brotli on;     # si el módulo está instalado
#   location = /index.html { include snippets/staydesk-headers.conf; add_header Cache-Control "no-cache" always; }
#   location = /sw.js      { include snippets/staydesk-headers.conf; add_header Cache-Control "no-cache" always; }
#
# (en nginx, un add_header dentro de location reemplaza a los del server; por eso se repite el include)
